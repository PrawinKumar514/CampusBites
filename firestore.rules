rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // A user can create their own profile upon signup
      allow create: if request.auth != null && request.auth.uid == userId;
      // A user can only read or update their own profile data
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // Admins can read any user's profile
      allow get: if request.auth != null && isAdmin();
      // Only admins can list all users
      allow list: if request.auth != null && isAdmin();
    }

    // Rules for the 'orders' collection
    match /orders/{orderId} {
      // Any authenticated user can create a new order for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Users can only read their own orders. Admins can read any order.
      allow get: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      // Only admins can update an order's status
      allow update: if request.auth != null && isAdmin();
      // Admins can list all orders. Users can list their own orders.
      allow list: if request.auth != null && (isAdmin() || request.query.where.userId == request.auth.uid);
    }
  }
}
